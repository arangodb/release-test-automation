{
  "collections": {
    "list_collections": {
      "endpoint": "/_api/collection",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    }
  },
  "users": {
    "create_user": {
      "endpoint": "/_api/user",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "user": "$1",
        "passwd": "$1"
      }
    }
  },
  "management api - permission validation": {
    "validate_permissions": {
      "endpoint": "/_management/permissions/validate",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "action":"$1",
        "resource":"$2"
      }
    }
  },
  "management api - policy": {
    "create_policy": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    },
    "list_policies": {
      "endpoint": "/_management/permissions/policy",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "get_policy_info": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "update_policy": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "put",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    },
    "delete_policy": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "delete",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    }
  },
  "management api - role": {
    "create_role": {
      "endpoint": "/_management/permissions/role/#1",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "policies": [
            "$1",
            "$2"
          ]
        }
      }
    },
    "list_roles": {
      "endpoint": "/_management/permissions/role",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "get_role_info": {
      "endpoint": "/_management/permissions/role/#1",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "update_role": {
      "endpoint": "/_management/permissions/role/#1",
      "method": "put",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "policies": [
            "$1",
            "$2"
          ]
        }
      }
    },
    "delete_role": {
      "endpoint": "/_management/permissions/role/#1",
      "method": "delete",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    }
  },
  "management api - role binding": {
    "create_role_binding": {
      "endpoint": "/_management/permissions/user/#1/role/#2",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "scope": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    },
    "list_role_bindings": {
      "endpoint": "/_management/permissions/user/#1/role",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "update_role_binding": {
      "endpoint": "/_management/permissions/user/#1/role/#2",
      "method": "put",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "scope": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    },
    "delete_role_binding": {
      "endpoint": "/_management/permissions/user/#1/role/#2",
      "method": "delete",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    }
  },
  "integration api - authentication": {
    "validate_token": {
      "endpoint": "/_integration/authn/v1/validate",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "token": "$1"
      }
    },
    "get_user_identity": {
      "endpoint": "/_integration/authn/v1/identity",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "do_login": {
      "endpoint": "/_integration/authn/v1/login",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "credentials": {
          "username": "$1",
          "password": "$2"
        }
      }
    },
    "do_logout": {
      "endpoint": "/_integration/authn/v1/logout",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "create_token": {
      "endpoint": "/_integration/authn/v1/createToken",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "user": "$1",
        "ttl": "3600"
      }
    }
  },
  "integration api - authorization": {
    "evaluate_user_permission": {
      "endpoint": "/_integration/authorization/v1/evaluate",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "user": "$1",
        "roles": ["$2"],
        "action": "db:Read",
        "resource": "db:*"
      }
    },
    "evaluate_user_permissions": {
      "endpoint": "/_integration/authorization/v1/evaluate-many",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "user": "$1",
        "roles": ["$2"],
        "items": [
          {"action": "db:Read", "resource": "db:*"},
          {"action": "db:UseApiVersion", "resource": "db:apiversion:v0"}
        ]
      }
    },
    "evaluate_token_permission": {
      "endpoint": "/_integration/authorization/v1/evaluate-token",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "token": "$1",
        "action": "db:Read",
        "resource": "db:*"
      }
    },
    "evaluate_token_permissions": {
      "endpoint": "/_integration/authorization/v1/evaluate-token-many",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "token": "$1",
        "items": [
          {"action": "db:Read", "resource": "db:*"},
          {"action": "db:UseApiVersion", "resource": "db:apiversion:v0"}
        ]
      }
    }
  }
}