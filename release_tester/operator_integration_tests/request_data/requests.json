{
  "collections": {
    "list_collections": {
      "endpoint": "/_api/collection",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    }
  },
  "users": {
    "create_user": {
      "endpoint": "/_api/user",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "user": "$1",
        "passwd": "$1"
      }
    }
  },
  "management api - permission validation": {
    "validate_permissions": {
      "endpoint": "/_management/permissions/validate",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "action":"$1",
        "resource":"$2"
      }
    }
  },
  "management api - policy": {
    "create_policy": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    },
    "list_policies": {
      "endpoint": "/_management/permissions/policy",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "get_policy_info": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "get",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    },
    "update_policy": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "put",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    },
    "delete_policy": {
      "endpoint": "/_management/permissions/policy/#1",
      "method": "delete",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {}
    }
  },
  "management api - role": {
    "create_role": {
      "endpoint": "/_management/permissions/role/#1",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "item": {
          "policies": [
            "$1",
            "$2"
          ]
        }
      }
    }
  },
  "management api - role binding": {
    "create_role_binding": {
      "endpoint": "/_management/permissions/user/#1/role/#2",
      "method": "post",
      "headers": {
        "Authorization": "Bearer !",
        "Content-Type": "application/json"
      },
      "payload": {
        "scope": {
          "statements": [
            {
              "effect":"$1",
              "actions":["$2"],
              "resources":["$3"]
            }
          ]
        }
      }
    }
  },
  "integration api - authentication": {
    "validate_token": {
      "endpoint": "/_integration/authn/v1/validate",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "payload": {
        "token": "$1"
      }
    }
  }
}